using Efni;

namespace Idun.TetraAuthDataTest {
	public void add_tests () {
		GLib.Test.add_func ("/TetraAuthData/reproduces-captured-blob", reproduces_captured_blob);
		GLib.Test.add_func ("/TetraAuthData/verifies-captured-encap-invite", verifies_captured_encap_invite);
	}

	private void reproduces_captured_blob () {
		TetraBinding[] bindings = {
			new TetraBinding (new Bytes ("tel:+4748270645".data), new Bytes (decode_hex ("f946664dfd8c7ea0ed58d9062321142231d266f86b458e89ae8e30d69bfaf16e")),
				new Bytes (decode_hex ("dbf5d35caf5250f23c47337693eea96d4dd827a9a868b6e2271147cd859ea2e9"))),
			new TetraBinding (new Bytes ("tel:+4748270645".data), new Bytes (decode_hex ("b4cf12e3f001248a438e824fa4c2c30121915dbbbaaf69e50d4ac2755cc0fa3a")),
				new Bytes (decode_hex ("66ce2c2b1d82e6c922071f25c751be5088b286786b6661d319d855b5dffea9ee")))
		};

		uint8[] built = TetraCrypto.build_authenticated_data ("com.apple.private.alloy.facetime.multi".data,
			decode_hex ("c999fd908f4cda286955c1bfda83ae43"),
			decode_hex ("5012aec942aae0c11cb6a0d6d675da76f240fdd982f7a34d35e45d47bc6b613e"), 1, bindings,
			new uint8[0], new uint8[0]);

		assert_true (new Bytes (built).compare (new Bytes (decode_hex (CAPTURED))) == 0);
	}

	private const string CAPTURED = "";

	private void verifies_captured_encap_invite () {
		try {
			TetraMessage message = TetraMessage.unwrap (decode_hex (ENCAP_INVITE));

			TetraBinding[] bindings = {
				new TetraBinding (new Bytes ("tel:+4748270645".data),
					new Bytes (decode_hex (CALLER_TOKEN)), new Bytes (decode_hex (CALLER_SIGNING))),
				new TetraBinding (new Bytes ("mailto:oravnas@gmail.com".data),
					new Bytes (decode_hex (IDUN_TOKEN)), new Bytes (decode_hex (IDUN_SIGNING)))
			};
			uint8[] encapsulation = message.kem_encapsulation != null
				? message.kem_encapsulation.get_data () : new uint8[0];
			uint8[] used_registered_keys = message.used_registered_keys != null
				? message.used_registered_keys.get_data () : new uint8[0];

			uint8[] authenticated_data = TetraCrypto.build_authenticated_data (
				"com.apple.private.alloy.facetime.multi".data, message.message_key_indicator.get_data (),
				message.ecdh_public_key.get_data (), message.message_index, bindings, encapsulation,
				used_registered_keys);
			uint8[] transcript = TetraCrypto.build_signature_transcript (message.version,
				message.ciphertext.get_data (), authenticated_data);

			assert_true (TetraCrypto.verify_with_point (decode_hex (CALLER_SIGNING), transcript,
				message.signature.get_data ()));
		} catch (Efni.Error e) {
			assert_not_reached ();
		}
	}

	private const string CALLER_TOKEN = "b4cf12e3f001248a438e824fa4c2c30121915dbbbaaf69e50d4ac2755cc0fa3a";
	private const string CALLER_SIGNING = "66ce2c2b1d82e6c922071f25c751be5088b286786b6661d319d855b5dffea9ee";
	private const string IDUN_TOKEN = "3c6177d1cccbe56c514628523db1c93b0dad30d080f72748691a7862d45aa5c6";
	private const string IDUN_SIGNING = "93630f4fff45747d6335a44b2a820818dc60e8263385240e3f1fc3fd7ccd6b27";
	private const string ENCAP_INVITE = "";

	private uint8[] decode_hex (string hex) {
		var bytes = new uint8[hex.length / 2];
		for (int i = 0; i != bytes.length; i++)
			bytes[i] = (uint8) (hex.substring (i * 2, 2).to_long (null, 16));
		return bytes;
	}
}
