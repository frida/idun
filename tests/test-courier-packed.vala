		try {
			var decoder = new CourierPacked (new Bytes (base_token));
			Variant notification = decoder.decode_notification (new Bytes (frame));

			Variant payload = notification.lookup_value ("payload", new VariantType ("a{sv}"));
			assert_nonnull (payload);

			Variant c = payload.lookup_value ("c", VariantType.INT64);
			assert_true (c.get_int64 () == 200);

			Variant qai = payload.lookup_value ("qai", VariantType.STRING);
			assert_cmpstr (qai.get_string (), EQ, "com.apple.private.alloy.facetime.multi");

			Variant qri = payload.lookup_value ("qri", VariantType.INT64);
			assert_true ((uint64) qri.get_int64 () == 14238014237319950512);
		} catch (Efni.Error e) {
			printerr ("%s\n", e.message);
			assert_not_reached ();
		}
	}
